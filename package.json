{
  "name": "activesite-website",
  "version": "1.0.0",
  "private": true,
  "description": "Activesite marketing website (EN/FR), built with Next.js.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "placeholders": "node scripts/placeholders.mjs",
    "placeholders:check": "node scripts/placeholders.mjs --check",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run placeholders:check"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "@fontsource/urbanist": "^5.3.0",
    "@hookform/resolvers": "6.0.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "4.0.3",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-mdx-remote": "6.0.0",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "reading-time": "1.5.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/nodemailer": "^7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
