# Copy to .env.local for development. On Hostinger, add these in hPanel → Websites → your Node.js app → Environment variables.
# Every value is optional: the site builds and runs without them, and each integration switches on once its keys are set.

# ---------- Site ----------
# Public base URL, used for canonical URLs, sitemap, Open Graph images and emails.
NEXT_PUBLIC_SITE_URL=https://activesite.cc

# ---------- Booking: Cal.com ----------
# Your Cal.com event path, e.g. "activesite/strategy-call" (from https://cal.com/activesite/strategy-call).
# Empty = "Book a free call" buttons go to /contact, which shows a WhatsApp fallback instead of the calendar.
NEXT_PUBLIC_CAL_LINK=

# ---------- Contact form email: Hostinger SMTP ----------
# hPanel → Emails → contact@activesite.cc → Configure → SMTP settings.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@activesite.cc
SMTP_PASS=
# Where new leads are sent, and the sender shown on emails (must be the authenticated mailbox).
CONTACT_TO=contact@activesite.cc
CONTACT_FROM="Activesite <contact@activesite.cc>"

# ---------- Newsletter: Brevo (double opt-in) ----------
# Brevo → SMTP & API → API keys.
BREVO_API_KEY=
# Brevo → Contacts → Lists: one list per language.
BREVO_LIST_ID_EN=
BREVO_LIST_ID_FR=
# Brevo → Templates: a "double opt-in" confirmation template per language.
BREVO_DOI_TEMPLATE_ID_EN=
BREVO_DOI_TEMPLATE_ID_FR=

# ---------- Spam protection: Cloudflare Turnstile ----------
# Cloudflare dashboard → Turnstile → Add site (activesite.cc). Empty = Turnstile off (honeypot + rate limit still on).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Analytics (loaded only after cookie consent) ----------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Google Search Console HTML-tag verification code (the "content" value only). Or verify by DNS and leave empty.
NEXT_PUBLIC_GSC_VERIFICATION=
# Meta Pixel ID and TikTok Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
